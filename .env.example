# --- WhatsApp Cloud API (Meta) ---
# From Meta for Developers > your App > WhatsApp > API Setup
WHATSAPP_TOKEN=your-permanent-or-temporary-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Any random string you choose yourself; enter the same value in the Meta
# webhook configuration screen.
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token

# --- AI (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Server ---
PORT=3000

# --- Dashboard login (simple HTTP Basic Auth) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# --- Storage ---
DATABASE_FILE=./data/orders.sqlite
