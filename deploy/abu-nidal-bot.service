[Unit]
Description=Abu Nidal Trading WhatsApp AI bot
After=network.target

[Service]
Type=simple
# Adjust if you deployed to a different path or run as a different user.
User=deploy
WorkingDirectory=/home/deploy/abu-nidal-trading-whatsapp-bot
ExecStart=/usr/bin/node dist/server.js
EnvironmentFile=/home/deploy/abu-nidal-trading-whatsapp-bot/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
